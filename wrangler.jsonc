{
  "name": "dagangos-portal",
  "main": "src/index.js",
  "compatibility_date": "2026-06-27",
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "BACKEND_ORIGIN": "dapuros.vercel.app",
    "GERAINA_BACKEND_ORIGIN": "geraina-os.vercel.app",
    "XENDIT_ENVIRONMENT": "production",
    "XENDIT_CHECKOUT_MODE": "payment_session",
    "AFFILIATE_CHECKOUT": "on",
    "AFFILIATE_PAYOUT_REVIEW": "on",
    "AFFILIATE_PAYOUTS": "on"
  },
  "d1_databases": [
    {
      "binding": "AFFILIATE_DB",
      "database_name": "dagangos-affiliate-production",
      "database_id": "37ebd428-a790-4ed4-b255-8573fbb696ec"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  }
}
